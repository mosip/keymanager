<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="KeyManager Pre-requisite API Test">
	<!-- Passing Group as parameter using "testType" Possible Groups are: smoke
		regression smokeAndRegression -->
	<listeners>
		<listener class-name="io.mosip.testrig.apirig.report.EmailableReport" />
	</listeners>

	<test name="GenerateMasterKey">
		<parameter name="ymlFile"
			value="keymanager/GenerateMasterKey/GenerateMasterKey.yml" />
		<parameter name="prerequisite" value="Yes" />
		<classes>
			<class name="io.mosip.testrig.apirig.keymanager.testscripts.SimplePost" />
		</classes>
	</test>

</suite>